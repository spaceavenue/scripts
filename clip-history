#!/usr/bin/sh

clip_list=$(cliphist list)

# selectors
fuzzel_selector() { printf "%s" "$clip_list" | fuzzel -d --prompt "> " --placeholder "Search clipboard..." --with-nth 2;}
fzf_selector() { printf "%s" "$clip_list" | fzf; }

selector="fuzzel"
type_mode=false

# parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --fzf)
            selector="fzf"
            shift
            ;;
        --fuzzel)
            selector="fuzzel"
            shift
            ;;
		-w)
			type_mode=true
			shift
			;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [--fzf | --fuzzel]"
            exit 1
            ;;
	esac
done

if [ "$selector" = "fzf" ]; then
    selection=$(fzf_selector)
else
    selection=$(fuzzel_selector)
fi

if [ "$type_mode" = true ]; then
    echo "$selection" | cliphist decode | tr '\n' ' ' | rustype -
else
    echo "$selection" | cliphist decode | wl-copy --trim-newline
fi
