#!/usr/bin/sh

emoji_ver="17.0.0"
list_url="https://www.unicode.org/Public/$emoji_ver/emoji/emoji-test.txt"
parsed_list="$XDG_CACHE_HOME/emoji-list"
font="Iosevka Etoile:size=16"

# parse list
if [ ! -f $parsed_list ]; then
    curl -s $list_url \
    | awk -F'# ' '/; fully-qualified/ {gsub(/E[0-9.]* /, ""); print $2}' \
    > $parsed_list
fi

# selectors
fuzzel_selector() { fuzzel --dmenu --font "$font" --hide-prompt < $parsed_list; }
fzf_selector() { fzf < $parsed_list; }

selector="fuzzel"
type_mode=false

# parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --fzf)
            selector="fzf"
            shift
            ;;
        --fuzzel)
            selector="fuzzel"
            shift
            ;;
		-w)
			type_mode=true
			shift
			;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [--fzf | --fuzzel]"
            exit 1
            ;;
	esac
done

if [ "$selector" = "fzf" ]; then
    selection=$(fzf_selector)
else
    selection=$(fuzzel_selector)
fi

# exit if cancelled
[ -z "$selection" ] && exit 0

if [ "$type_mode" = true ]; then
	echo "$selection" | cut -d' ' -f1 | tr '\n' ' ' | wtype -
else
    echo "$selection" | cut -d' ' -f1 | wl-copy --trim-newline
fi
