# selectors
fuzzel_selector() { fuzzel --dmenu --prompt "> " --placeholder "Search glyphs..." --font "$font" < $parsed_list; }
fzf_selector() { fzf < $parsed_list; }

selection=$(fuzzel_selector)

# parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --fzf)
            selection=$(fzf_selector) 
            break
            ;;
        --fuzzel)
            selection=$(fuzzel_selector)
            break
            ;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [--fzf | --fuzzel]"
            exit 1
            ;;
    esac
done

# exit if cancelled
[ -z "$selection" ] && exit 0

# copy the selection
echo "$selection" | cut -d' ' -f1 | wl-copy --trim-newline
