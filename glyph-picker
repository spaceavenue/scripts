# selectors
fuzzel_selector() { fuzzel --dmenu --prompt "> " --placeholder "Search glyphs..." --font "$font" < $parsed_list; }
fzf_selector() { fzf < $parsed_list; }

selector="fuzzel"
type_mode="false"

# parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --fzf)
            selector="fzf"
            shift
            ;;
        --fuzzel)
            selector="fuzzel"
            shift
            ;;
		-w)
			type_mode=true
			shift
			;;
        *)
            echo "Unknown option: $1"
            echo "Usage: $0 [--fzf | --fuzzel]"
            exit 1
            ;;
	esac
done

if [ "$selector" = "fzf" ]; then
    selection=$(fzf_selector)
else
    selection=$(fuzzel_selector)
fi

# exit if cancelled
[ -z "$selection" ] && exit 0

if [ "$type_mode" = true ]; then
	echo "$selection" | cut -d' ' -f1 | tr '\n' ' ' | wtype -
else
    echo "$selection" | cut -d' ' -f1 | wl-copy --trim-newline
fi

