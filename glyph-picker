#!/usr/bin/sh

list_url="https://raw.githubusercontent.com/ryanoasis/nerd-fonts/master/css/nerd-fonts-generated.css"
parsed_list="$XDG_CACHE_HOME/glyph-list"
font="Symbols Nerd Font:size=16"

# parse list if it doesnt exist
if [ ! -f $parsed_list ]; then
    curl -s $list_url \
    | awk '/:before/ { gsub(/^\.nf-|:before/, "", $1); name=$1 } 
            /content:/ { gsub(/[^0-9a-fA-F]/, "", $2); 
            printf("%c %s\n", strtonum("0x" $2), name) }' \
    > $parsed_list
fi

