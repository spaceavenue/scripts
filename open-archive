#!/usr/bin/env fish

if test (count $argv) -eq 0
    echo "usage: open-archive <path-to-archive>"
    exit 1
end

set ARCHIVE_PATH $argv[1]
set ARCHIVE_NAME (path basename -E $ARCHIVE_PATH)
set TMP_ROOT (mktemp -d /tmp/archive_XXXXXX)
set TARGET_DIR "$TMP_ROOT/$ARCHIVE_NAME"

mkdir -p $TARGET_DIR

ouch decompress $ARCHIVE_PATH --dir $TARGET_DIR

foot yazi $TARGET_DIR

rm -rf $TMP_ROOT
