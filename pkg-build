#!/usr/bin/env fish

function __say
    set_color $argv[1]
    echo $argv[2..-1]
    set_color normal
end

function __section
    __say 89b4fa --------------------------------------------------
    set_color --bold ffd1db
    echo $argv
    set_color normal
end

function __confirm
    set_color f38ba8
    read -P "build '$argv[1]'? [y/N]: " -l reply
    set_color normal
    string match -qi 'y*' "$reply"
end

# do we track this?
function __tracked
    grep -qF "[$argv[1]]" "$XDG_CONFIG_HOME/nvchecker/nvchecker.toml" 2>/dev/null
end

# print upstream version if nvcmp reports update
function __new_version
    set -l pat (string escape --style=regex $argv[1])
    string match -rg "^$pat\s+\S+\s+(?:->|<-|\+\+)\s+(\S+)" -- $argv[2..-1]
end

# bumps PKGBUILD but no nvtake.
function __apply_update
    __say f38ba8 "new version for $argv[1]: $argv[2]"

    # pkgver can't contain hyphens
    set -l ver (string replace -a - _ -- $argv[2])
    sed -i -e "s/^pkgver=.*/pkgver=$ver/" -e 's/^pkgrel=.*/pkgrel=1/' PKGBUILD
    updpkgsums
end

# -----------------------------------------------------

set -l PKG_ROOT "$XDG_CONFIG_HOME/pkg"
set -l EXCLUDED_PKGS ttf-ibm-plex-custom obsidian-custom signal-desktop-custom vesktop-custom clang-gccless
set -l REPO mine
set -l REPO_DIR /var/local/mine
set -l LOG_FILE "$XDG_STATE_HOME/pkg-build.log"
set -l failed

nvchecker
set -l nvcmp_out (nvcmp 2>/dev/null)

__section "updating our packages"

for pkg_dir in (path filter -d $PKG_ROOT/*)
    set -l pkg (path basename $pkg_dir)

    contains -- $pkg $EXCLUDED_PKGS; and continue

    # tracked packages w/o updates skip silently (noisy). untracked ones always prompt
    set -l new_ver
    if __tracked $pkg
        set new_ver (__new_version $pkg $nvcmp_out)
        if test -z "$new_ver"
            # __say cba6f7 "no update found for $pkg, skipping"
            continue
        end
    end

    if not __confirm $pkg
        __say cba6f7 "skipping $pkg"
        continue
    end

    __say ffabab "~> processing: $pkg"
    cd $pkg_dir; or continue

    if test -n "$new_ver"
        __apply_update $pkg $new_ver
    else
        __say cba6f7 "not in nvchecker"
    end

    aur build -f -d $REPO --margs '-C,-s,-r' &| tee -a $LOG_FILE
    if test $pipestatus[1] -ne 0
        __say f38ba8 "failed to build $pkg :("
        set -a failed $pkg
    else
        __say ffd1db "added $pkg to local repo!"
        test -n "$new_ver"; and nvtake $pkg
    end

    command rm -rf src pkg 2>/dev/null
end

__section "updating AUR packages"
aur sync -u -d $REPO

__section "removing old packages in [$REPO]"
paccache -c $REPO_DIR -rk1

if set -q failed[1]
    __say f38ba8 "failed to build: $failed"
    exit 1
end
