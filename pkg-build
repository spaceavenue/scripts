#!/usr/bin/env fish

function __confirm
	set -l pkg_name $argv[1]
	read -P "build '$pkg_name'? [y/N]: " -l reply
	string match -qi 'y*' "$reply"
end

# checks if we track the package via nvchecker
function __tracked
	set -l PKGNAME $argv[1]
	string match -q "*[$PKGNAME]*" (cat "$XDG_CONFIG_HOME"/nvchecker/nvchecker.toml 2>/dev/null)
end

# checks if there is an update, no updates, no prompt, gets skipped
function __has_update
	set -l PKGNAME $argv[1]
	set -l NVCMP_OUT $argv[2..-1]

	if not __tracked $PKGNAME
		return 0
	end

	string match -qr "^$PKGNAME\s+\S+\s+(?:->|\+\+)\s+(\S+)" -- $NVCMP_OUT
end

# bumps version in PKGBUILD but no nvtake.
# so if a build fails, we can still build the package later via the script
function __apply_update
	set -l PKGNAME $argv[1]
	set -l PKGBUILD $argv[2]
	set -l NVCMP_OUT $argv[3..-1]

	if not __tracked $PKGNAME
		echo "not in nvchecker"
		return
	end

	set -l match (string match -r "^$PKGNAME\s+\S+\s+(?:->|\+\+)\s+(\S+)" -- $NVCMP_OUT)
	if test (count $match) -ge 2
		set -l NEW_VER $match[2]
		echo "new version for $PKGNAME: $NEW_VER"

		sed -i "s/^pkgver=.*/pkgver=$NEW_VER/" $PKGBUILD
		sed -i "s/^pkgrel=.*/pkgrel=1/" $PKGBUILD
		updpkgsums
	end
end

# -----------------------------------------------------

set -l CUSTOM_PKGS (find "$HOME/pkgs" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
set -l REPO "mine"

set -x REVIEW_PAGER less
if type -q bat
	set -x REVIEW_PAGER "bat --paging=always --language=PBD"
else if set -q PAGER
    set -x REVIEW_PAGER $PAGER
end

set -l LOG_FILE "$XDG_STATE_HOME/pkg-build.log"
nvchecker

set -l NVCMP_OUT (nvcmp 2>/dev/null)

echo "--------------------------------------------------"
echo "updating our packgages"
for pkg_dir in $CUSTOM_PKGS
    set -l pkg_name (basename "$pkg_dir")

	if not __has_update $pkg_name $NVCMP_OUT
		echo "no update found for $pkg_name, skipping"
		continue
	end

	if not __confirm $pkg_name
		echo "skipping $pkg_name"
		continue
	end

    echo "~> processing: $pkg_name"

	pushd "$pkg_dir" >/dev/null

	__apply_update $pkg_name ./PKGBUILD $NVCMP_OUT

	aur build -d $REPO --margs '-C,-s,-r,--cleanbuild' &| tee -a $LOG_FILE
	if test $pipestatus[1] -ne 0
		echo "failed to build $pkg_name"
	else
		echo "added $pkg_name to local repo!"
		__tracked $pkg_name; and nvtake "$pkg_name"
	end

	command rm -rf src pkg 2>/dev/null
	popd >/dev/null
end

echo "--------------------------------------------------"
echo "updating AUR packages"
aur sync -u -d $REPO
