#!/usr/bin/env fish

function __confirm
	set -l pkg_name $argv[1]
	read -P "build '$pkg_name'? [y/N]: " -l reply
	string match -qi 'y*' "$reply"
end

function __nvchecker
	set -l PKGNAME $argv[1]
	set -l PKGBUILD $argv[2]

	# if not configured in nvchecker, just return 0
	if not string match -q "*[$PKGNAME]*" (cat "$XDG_CONFIG_HOME"/nvchecker/nvchecker.toml 2>/dev/null)
        return 0
    end

	set -l match (nvcmp 2>/dev/null | string match -r "^$PKGNAME\s+\S+\s+->\s+(\S+)")
    if test (count $match) -ge 2
		set -l NEW_VER $match[2]
        echo "new version for $PKGNAME: $NEW_VER"
        
        sed -i "s/^pkgver=.*/pkgver=$NEW_VER/" $PKGBUILD
        sed -i "s/^pkgrel=.*/pkgrel=1/" $PKGBUILD
        updpkgsums

        nvtake "$PKGNAME"
		return 0
	end
	return 1
end

# -----------------------------------------------------

set -l CUSTOM_PKGS (find "$HOME/pkgs" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
set -l REPO "mine"

set -x REVIEW_PAGER less
if type -q bat
	set -x REVIEW_PAGER "bat --paging=always --language=PBD"
else if set -q PAGER
    set -x REVIEW_PAGER $PAGER
end

set -l LOG_FILE "$XDG_STATE_HOME/pkg-build.log"
nvchecker

echo "--------------------------------------------------"
echo "updating our packgages"
for pkg_dir in $CUSTOM_PKGS
    set -l pkg_name (basename "$pkg_dir")

	if not __confirm $pkg_name
		echo "skipping $pkg_name"
		continue
	end

    echo "~> processing: $pkg_name"

	pushd "$pkg_dir" >/dev/null

	if __nvchecker $pkg_name ./PKGBUILD
		aur build -d $REPO --margs '-C,-s,-r,--cleanbuild' &| tee -a $LOG_FILE
		if test $pipestatus[1] -ne 0
			echo "failed to build $pkg_name"
		else
			echo "added $pkg_name to local repo!"
		end
	else
		echo "no update found for $pkg_name"
	end

	command rm -rf src pkg 2>/dev/null
	popd >/dev/null
end

echo "--------------------------------------------------"
echo "updating standard AUR packages"
aur sync -u -d $REPO
