#!/bin/sh

boot() {
    echo 0 > /proc/sys/kernel/nmi_watchdog

    if [ -d "/sys/class/power_supply/BAT0" ]; then
        echo 75 > /sys/class/power_supply/BAT0/charge_control_start_threshold
        echo 80 > /sys/class/power_supply/BAT0/charge_control_end_threshold
    fi
}

ac() {
    [ -f /sys/firmware/acpi/platform_profile ] && echo "performance" > /sys/firmware/acpi/platform_profile

    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -f "$f" ] && echo "performance" > "$f"
    done

    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -f "$f" ] && echo 400000 > "$f"
    done
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -f "$f" ] && echo 4830000 > "$f"
    done
}

bat() {
    [ -f /sys/firmware/acpi/platform_profile ] && echo "low-power" > /sys/firmware/acpi/platform_profile

    for f in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -f "$f" ] && echo "balance_power" > "$f"
    done

    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_min_freq; do
        [ -f "$f" ] && echo 400000 > "$f"
    done
    for f in /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq; do
        [ -f "$f" ] && echo 2300000 > "$f"
    done
}

case "$1" in
    boot)
        boot
        if cat /sys/class/power_supply/AC*/online 2>/dev/null | grep -q "1"; then
            ac
        else
            bat
        fi
        ;;
    ac)
        ac
        ;;
    battery)
        bat
        ;;
esac
